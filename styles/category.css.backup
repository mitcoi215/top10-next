/* Page Layout from template */
.setoff-box {
  width: 100%;
  z-index: 22;
}

.page {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
  max-width: 1170px;
  margin: 0 auto;
}

.page-header {
  display: flex;
  box-sizing: border-box;
  margin: 20px 0;
  padding: 0;
  justify-content: space-between;
  min-height: 24px;
  width: 100%;
}

.page-header__left {
  display: flex;
  align-items: center;
}

.page-header__breadcrumb-offset {
  display: flex;
  align-items: center;
}

/* Breadcrumb from template */
.breadcrumb {
  list-style: none;
  display: flex;
  flex-direction: row;
  margin: 0;
  padding: 0;
  align-items: flex-start;
}

.breadcrumb li {
  font-size: 14px;
  line-height: 24px;
  font-weight: 400;
  color: #797979;
  text-transform: capitalize;
  display: flex;
  margin: 0;
  padding: 0;
  transition: all 0.3s ease;
}

.breadcrumb li:hover {
  opacity: 1;
  color: #2d2d2d;
}

.breadcrumb li:after {
  font-size: 14px;
  line-height: 24px;
  font-weight: 400;
  color: #797979;
  content: '/';
  display: flex;
  margin: 0 6px;
}

.breadcrumb li:first-of-type {
  margin: 0;
}

.breadcrumb li:last-of-type {
  pointer-events: none;
}

.breadcrumb li:last-of-type:after {
  display: none;
}

.breadcrumb li a {
  color: inherit;
  text-decoration: none;
}

.breadcrumb li a:hover {
  color: #1789d5;
}

/* Charticle Header from template */
.charticle__header {
  padding: 0;
  width: 100%;
}

.charticle__header .container {
  display: flex;
  flex-direction: column;
}

.charticle__header .info {
  display: flex;
  flex-direction: column;
}

.charticle__header .title {
  margin: 50px 0 40px 0;
  display: flex;
  flex-direction: column;
  font-size: 35px;
  line-height: 1.14;
  font-weight: bold;
  color: #2d2d2d;
}

@media (max-width: 768px) {
  .charticle__header .title {
    font-size: 28px;
    margin: 30px 0 20px 0;
  }
}

.charticle__header .details {
  display: flex;
  flex-direction: column;
}

.charticle__header .placeholder {
  height: 0;
}

.charticle__header .img {
  width: 100%;
  height: auto;
  margin-top: 24px;
}

/* By-author from template */
.by-author {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 14px;
  line-height: 19px;
  font-weight: 400;
  color: #797979;
}

.by-author__author-credentials {
  display: flex;
  align-items: center;
}

.by-author__image {
  display: flex;
  border-radius: 50%;
  margin: 4px 10px 0 -1px;
  width: 36px;
  height: 36px;
  overflow: hidden;
  object-fit: cover;
}

.by-author__author-metadata {
  display: flex;
  flex-direction: column;
}

.by-author__author-name {
  display: flex;
  flex-direction: row;
}

.by-author__author {
  display: flex;
  align-items: center;
  font-weight: 600;
  text-decoration: none;
  color: inherit;
}

.by-author__author:hover {
  color: #ff4a64;
}

.by-author__pubdate {
  display: flex;
  align-items: center;
}

/* Social Share from template */
.social-share {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 10px;
}

.charticle__header .social-share {
  margin-left: auto;
}

.charticle__left .social-share {
  flex-direction: column;
  position: sticky;
  top: 100px;
}

.social-share__button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  background-color: #f5f5f5;
  border: none;
  transition: background-color 0.3s;
  list-style: none;
}

.social-share__button.btn-facebook {
  fill: #4168b1;
}

.social-share__button.btn-facebook:hover {
  background-color: #4168b1;
  fill: white;
}

.social-share__button.btn-twitter {
  fill: #1da1f1;
}

.social-share__button.btn-twitter:hover {
  background-color: #1da1f1;
  fill: white;
}

.social-share__icon {
  width: 20px;
  height: 20px;
  padding: 10px;
}

/* Navbar from template */
.navbar {
  position: relative;
  z-index: 20;
}

/* TOC from template */
.toc {
  display: flex;
  background-color: #f5f5f5;
  height: auto;
  padding: 15px 0 5px 10px;
  box-sizing: border-box;
  flex-direction: column;
  margin: 10px 0 0 0;
  max-height: 390px;
  overflow: hidden;
  width: 135px;
  max-width: 135px;
}

.toc__title {
  display: flex;
  box-sizing: border-box;
  margin-right: 10px;
  align-content: center;
  margin-bottom: 14px;
  font-size: 16px;
  line-height: 19px;
  font-weight: 700;
  color: #000;
}

.toc__items-container {
  box-sizing: border-box;
  display: flex;
  height: auto;
  max-height: 340px;
  width: 100%;
  overflow-y: scroll;
  overflow-x: hidden;
}

.toc__items {
  display: flex;
  margin: 0;
  padding: 0 10px 0 0;
  list-style: none;
  flex-direction: row;
  flex-wrap: wrap;
}

/* Chart from template */
.chart {
  margin: 0;
  width: 100%;
}

.chart__body {
  display: flex;
  flex-direction: column;
}

.chart__body__products {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Charticle layout from template */
.charticle {
  margin-top: 20px;
  max-width: 1170px;
  margin-left: auto;
  margin-right: auto;
  padding: 0 15px;
}

@media (min-width: 1000px) {
  .charticle {
    padding: 0;
  }
}

.charticle__top {
  display: flex;
  padding: 0;
}

.charticle__left {
  margin-right: 50px;
  display: none;
}

@media (min-width: 1000px) {
  .charticle__left {
    display: block;
  }
}

.charticle__center {
  width: 100%;
  max-width: 635px;
}

.charticle__right {
  display: none;
  margin-left: 50px;
  width: 300px;
}

@media (min-width: 1000px) {
  .charticle__right {
    display: block;
  }
}

/* Charticle chart from template */
.charticle-chart {
  margin: 32px 0;
}

.charticle-best-for {
  margin: 24px 0;
}

/* Show more container */
.show-more__container {
  margin-bottom: 24px;
}

.show-more__wrapper {
  overflow: hidden;
}

.show-more__content {
  padding: 0;
}

/* WYSIWYG content */
.charticle__wysiwyg {
  font-size: 16px;
  line-height: 1.7;
  color: #2d2d2d;
}

.charticle__wysiwyg p {
  margin-bottom: 16px;
}

.charticle__wysiwyg a {
  color: #1789d5;
  text-decoration: none;
}

.charticle__wysiwyg a:hover {
  text-decoration: underline;
}

/* FAQ Section */
.charticle__faq {
  margin: 50px 0;
  padding: 50px 0;
  border-bottom: 1px solid #d5d5d5;
  border-top: 1px solid #d5d5d5;
  width: 100%;
}

/* Bottom section */
.charticle__bottom {
  display: flex;
  margin-top: 50px;
  flex-direction: column;
  margin-left: 0;
  margin-right: 15px;
  width: 100%;
}

@media (min-width: 1000px) {
  .charticle__bottom {
    padding: 0;
    width: 635px;
    margin-left: 185px;
  }
}

.charticle__body--bottom-title {
  font-size: 24px;
  font-weight: 700;
  color: #2d2d2d;
  margin-bottom: 24px;
}

/* =============================================== */
/* Additional CSS classes from template           */
/* =============================================== */

/* Checkmark icon in author pubdate */
.css-4qp2h0 {
  color: #106197;
  margin-right: 4px;
}

/* Dark logo - hidden by default */
.dark-logo {
  display: none;
}

/* Social share in charticle header - horizontal layout */
.charticle__header .details {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

/* Score Citation text */
.css-ncmbik {
  font-size: 14px;
  color: #797979;
}

/* Product SOA (Score) container */
.css-1myhh97 {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 8px;
}

/* Setoff box styles from template */
.setoff-box {
  background-color: #ffffff;
  border-bottom: 1px solid #bdbdbd;
}

.css-19i7pex {
  display: flex;
  width: 100%;
  justify-content: center;
  background-color: #ffffff;
}

/* Mobile hamburger menu */
.hamburger-menu {
  font-size: 24px;
  cursor: pointer;
}

/* Backdrop for mobile menu */
.backdrop {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 10;
}

/* Mobile menu styles */
@media (max-width: 768px) {
  .css-q8f278 {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    width: 280px;
    height: 100%;
    background-color: #fff;
    flex-direction: column;
    gap: 0;
    padding: 20px 0;
    z-index: 20;
    box-shadow: -4px 0 16px rgba(0, 0, 0, 0.1);
  }

  .css-1hlbggb:checked ~ .nav-bar-link-list {
    display: flex;
  }

  .css-1hlbggb:checked ~ .backdrop {
    display: block;
  }

  .css-5s1gij {
    display: flex;
    justify-content: flex-end;
    padding: 10px 20px;
    cursor: pointer;
  }

  .css-18ojb17 {
    padding: 12px 20px;
    border-bottom: 1px solid #e0e0e0;
  }

  .css-1u50saz {
    display: block;
    width: 100%;
  }
}

/* Missing CSS classes from components */

/* Chart product text wrapper */
.chart-product-text {
  margin: 0;
}

/* Nilink - clickable product */
.nilink {
  cursor: pointer;
}

/* Check mark icon */
.check-mark {
  flex-shrink: 0;
}

/* Light logo display */
.light-logo {
  display: block;
}

/* Product logo */
.product-logo {
  object-fit: contain;
}

/* End icon for CTA button */
.endIcon {
  display: inline-flex;
  align-items: center;
}

/* Disclosure container */
.css-16cmgru {
  display: flex;
  align-items: center;
}

@media (max-width: 1200px) {
  .css-16cmgru {
    display: flex;
    position: relative;
    width: 100%;
    justify-content: flex-end;
    margin-top: 8px;
    min-width: 150px;
  }
}

/* Advertising disclosure */
.css-1dgld9d {
  position: relative;
  display: inline-block;
}

/* Product ribbon */
.css-s57r0x {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: linear-gradient(90deg, #09553D 0%, #0a6b4d 100%);
  color: white;
  padding: 6px 12px;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 600;
}

/* Emotion class placeholder */
.elnea280 {
  /* Placeholder for emotion generated class */
}

