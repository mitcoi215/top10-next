// prisma/schema.prisma
// MongoDB Database Schema for Top10 Rating
// Version 2.0 - Complete CMS Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ============================================
// ADMIN - Authentication
// ============================================
model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

// ============================================
// AUTHOR - Content Writers (E-E-A-T)
// ============================================
model Author {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String    @unique
  name        String
  avatar      String?
  title       String?   // "Technology Writer", "Dating Expert"
  bio         String?   // Short biography
  socialLinks Json?     // { twitter?: string, linkedin?: string, website?: string }

  // Relations
  products    Product[]
  articles    Article[]
  categories  Category[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// CATEGORY GROUP - Homepage display groups
// e.g., Lifestyle, Health & Wellness, Home, Business, Security
// ============================================
model CategoryGroup {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String    @unique
  name        String    // "Lifestyle", "Health & Wellness"
  icon        String?   // Emoji or icon URL
  order       Int       @default(0)

  // Relations
  categories  Category[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// CATEGORY - Main content hub (e.g., TV Services, Dating, VPN)
// Each Category belongs to a CategoryGroup for homepage display
// ============================================
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String    @unique
  name        String
  icon        String
  color       String    @default("bg-white")
  description String?   // Short description for cards

  // Parent group for homepage organization
  groupId     String?   @db.ObjectId
  group       CategoryGroup? @relation(fields: [groupId], references: [id])

  // Display settings
  featured    Boolean   @default(false)
  showInHero  Boolean   @default(false) // Show in homepage hero dropdown
  order       Int       @default(0)

  // Homepage hero dropdown links
  exploreHref     String?   // "/tv-services" - link for Explore button
  compareHref     String?   // "/tv-services/compare" - link for Compare button

  // Category Author (for display on category page)
  authorId    String?   @db.ObjectId
  author      Author?   @relation(fields: [authorId], references: [id])

  // Category Listing Page - Header
  heroImage       String?
  heroTitle       String?   // Override title for the page
  lastUpdated     DateTime?

  // Category Listing Page - Intro Content
  introContent    String?   // HTML content for intro section

  // Category Listing Page - Sidebar
  sidebarPeopleCount  String?   // "167,536" - people who shopped
  sidebarArticleIds   String[]  @db.ObjectId // Articles for sidebar "Must Reads"

  // Category Listing Page - Best Of List Section
  bestOfListTitle     String?   // "Our Top 10 Best TV Streaming Services:"

  // Category Listing Page - Compare Box (in Methodology section)
  compareBoxTitle       String?   // "Compare With 10rating, Choose the Best for You"
  compareBoxDescription String?   // Description paragraph
  compareBoxStats       String?   // "15 TV Streaming Services Evaluated | 8 Criteria | 10 Best"

  // Comparison Page (/[category]/comparison)
  comparisonRedirectEnabled Boolean @default(false) // Auto-redirect listing page to comparison page
  comparisonTitle       String?   // Hero title for comparison page
  comparisonSubtitle    String?   // Hero subtitle/description
  comparisonHeroImage   String?   // Hero background image
  comparisonProductOrder String[] // Custom product ordering for comparison page (array of product IDs)

  // Comparison Page - Top 3 Products Bar
  comparisonTop3Enabled     Boolean   @default(false)
  comparisonTop3Title       String?   // "Top 3 Home Security Services"
  comparisonTop3ProductIds  String[]  // ordered product IDs (up to 3)
  comparisonTop3Ribbon      String?   // Ribbon text for #1, e.g. "Our Recommendation"
  comparisonTop3ProductData Json?     // Per-product overrides for Top3 bar: [{id, overallScore, scoreLabel, bottomLine, ribbon, ctaUrl, ctaText, features}]

  // Comparison Page - Right Sidebar (Best Overall)
  comparisonRightSidebarEnabled   Boolean @default(false)
  comparisonRightSidebarProductId String? // null = auto (rank #1)

  // Comparison Page - Left Sidebar
  comparisonLeftSidebarEnabled  Boolean @default(true)
  comparisonSocialProofCount    String?   // "13,810"
  comparisonScoreBreakdown      Json?     // [{ name, description, score }]

  // Comparison Page - Below FAQ Content (Rich Text / Wysiwyg from data-role="chart-wysiwyg-container")
  comparisonBelowFaqContent     String?

  // Category Listing Page - Closer Look Section
  closerLookTitle     String?   // "A Closer Look at the Top 10 TV Streaming Services"

  // Category Listing Page - Criteria Definitions
  // Defines what scores/highlights are available for products in this category
  criteriaDefinitions Json?   // [{ key: "security", label: "Security", maxScore: 10 }]
  highlightDefinitions Json?  // [{ key: "startingPrice", label: "Starting Price" }, ...]

  // Methodology Section (Category-specific)
  methodologyTitle    String?   // "Our Methodology: How We Reviewed..."
  methodologyIntro    String?   // Intro paragraph for methodology
  criteriaTitle       String?   // "Here are some of the criteria we evaluated:"
  methodologyCriteria Json?     // [{ title: "Value", description: "We evaluate..." }]
  exploreTitle        String?   // "Explore More TV Streaming Services:"
  exploreCards        Json?     // [{ title: "Best VPN", href: "/vpn", image: "..." }]

  // Review List Page Content (/dating/reviews)
  reviewListTitle     String?   // "In-Depth Online Dating Sites and Apps Reviews"
  reviewListSubtitle  String?   // Subtitle/description for review list page
  reviewListIntro     String?   // Intro paragraph for review list
  reviewListHeroImage String?
  top5ProductIds      String[]  @db.ObjectId // Products for sidebar "Best X" widget
  tenThingsToKnow     Json?     // [{ title: "...", description: "..." }]
  mustReadArticleIds  String[]  @db.ObjectId // Article IDs for Must Reads

  // Product Review Page - Sidebar
  editorialReviewTitle      String?   // "Editorial Reviews"
  editorialReviewProductIds String[]  @db.ObjectId // Products for sidebar on review pages

  // Bottom Content (above FAQ) - Comparison table, experts section, etc.
  bottomContent       String?   // JSON blocks displayed above FAQ section

  // Additional Content (below Bottom Content) - More structured blocks
  additionalContent   String?   // JSON blocks displayed below Bottom Content

  // FAQ Section (Category-level)
  faqs                Json?     // [{ question: "...", answer: "..." }]

  // SEO
  metaTitle           String?
  metaDescription     String?
  ogImage             String?

  // Relations
  products    Product[]
  articles    Article[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// PRODUCT - Main entity (~65 fields)
// ============================================
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  // ========== NHÓM 1: METADATA & BASIC INFO (12 fields) ==========
  slug        String   @unique
  name        String
  logoUrl     String?

  // CTA & Links
  ctaUrl      String?   // Affiliate link
  ctaText     String    @default("Visit Site")
  reviewHref  String?   // "/dating/reviews/eharmony"

  // Status & Workflow
  status      String    @default("draft") // 'draft' | 'published'

  // Relations
  categoryId  String    @db.ObjectId
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId    String?   @db.ObjectId
  author      Author?   @relation(fields: [authorId], references: [id])

  // ========== NHÓM 2: CATEGORY LISTING DATA (12 fields) ==========
  rank        Int       @default(0)
  ribbon      String?   // "Best Overall", "Editor's Choice"
  tagline     String?   // Short tagline under name
  bottomLine  String?   // Longer description for listing
  bestFor     String?   // "Best for serious daters"
  basePrice   String?   // "$40/month", "Free"

  // Scores
  overallScore    Float?    // 9.2 - for sorting
  scoreLabel      String?   // "Excellent", "Very Good", "Good"
  scores          Json?     // { security: 9.2, speed: 8.5, support: 8.0 }

  // Highlights (flexible key-value based on category definitions)
  highlights      Json?     // { "startingPrice": "$19.99", "trialPeriod": "30 days" }

  // Features list for listing/review page
  features        Json?     // [{ text: "Live TV channels", bold: true }, ...]

  // Features list for comparison page (separate from review features)
  comparisonFeatures Json?  // ["AI site creation tools included", "Powers 2M+ websites", ...]

  // Customer quote
  quote           Json?     // { text: "Great service!", source: "John D.", date: "2024" }

  // ========== NHÓM 3: REVIEW CONTENT (25 fields) ==========
  // Review Hero
  reviewTitle     String?   // "eharmony Dating Site Review (2026)"
  reviewSubtitle  String?   // "Trusted Dating App for Serious Relationships"
  reviewHeroImage String?

  // Ratings display
  rating          Float?    // User rating (e.g., 3.0)
  reviewCount     String?   // "3,598 Reviews"
  readTime        String?   // "5 min" - estimated read time

  // Hero Summary
  summaryTitle    String?   // "Is IONOS Worth Signing Up For?"
  heroSummary     String?   // Opening paragraph

  // Video
  videoUrl        String?   // Video URL (YouTube, Vimeo, Dailymotion, etc.)

  // Pros & Cons
  pros            String[]
  cons            String[]

  // Main Content
  mainContent     String?   // Rich Text / HTML - Full review content

  // Verdict
  verdict         String?   // Concluding paragraph

  // Images gallery
  images          String[]

  // ========== NHÓM 4: FAQ & EXTRAS (10 fields) ==========
  faqs            Json?     // [{ question: "...", answer: "..." }]

  // User ratings breakdown (if different from editorial)
  userRatings     Json?     // { overall: 4.2, features: 4.0, value: 3.8 }

  // Related products
  relatedProductIds String[] @db.ObjectId

  // ========== NHÓM 5: SEO (4 fields) ==========
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonical       String?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  @@index([categoryId])
  @@index([status])
  @@index([rank])
}

// ============================================
// ARTICLE - Charticles & Blog Posts
// ============================================
model Article {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique

  // Basic Info
  title       String
  subtitle    String?
  articleType String   @default("charticle") // 'charticle' | 'blog' | 'guide'

  // Status
  status      String   @default("draft") // 'draft' | 'published'

  // Relations
  categoryId  String?  @db.ObjectId
  category    Category? @relation(fields: [categoryId], references: [id])
  authorId    String?  @db.ObjectId
  author      Author?  @relation(fields: [authorId], references: [id])

  // Header
  featuredImage    String?
  featuredImageAlt String?

  // Content
  content          String?   // Rich Text / HTML - Main content
  excerpt          String?   // Short excerpt for listings

  // Products mentioned in article (for widget/cards)
  productIds       String[]  @db.ObjectId

  // Sidebar configuration
  sidebarTitle     String?   // "Best TV Streaming Services"
  sidebarSeeAllHref String?  // "/tv-services"
  sidebarSeeAllText String?  // "See All TV Services"

  // Breadcrumbs (optional override)
  breadcrumbs      Json?     // [{ label: "Home", href: "/" }, ...]

  // SEO
  metaTitle        String?
  metaDescription  String?
  ogImage          String?
  canonical        String?

  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  publishedAt      DateTime?

  @@index([categoryId])
  @@index([status])
  @@index([articleType])
}

// ============================================
// HOMEPAGE SETTINGS - Singleton config
// ============================================
model HomepageSettings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  // Hero Section
  heroTagline     String?   // Main tagline: "Compare and shop the Top10 best..."
  heroTitle       String?
  heroSubtitle    String?

  // Featured Category Groups (for hero dropdown)
  featuredGroupIds String[] @db.ObjectId

  // Featured Categories (for settings page)
  featuredCategoryIds String[] @db.ObjectId

  // Trending Section (curated)
  trendingItems   Json?     // [{ groupId, title, description, image, articles: [{ title, href, image, author, date }] }]

  // Stats Section
  statsListsCount     String?   // "500+"
  statsHoursCount     String?   // "5,000+"
  statsDecisionsCount String?   // "16M+"

  // Experts Section
  expertIds       String[]  @db.ObjectId // Author IDs

  // Mission Section
  missionTitle    String?
  missionContent  String?
  missionImage    String?
  missionCta      String?   // CTA link

  // Method Section (Our Method)
  methodTitle     String?
  methodContent   String?
  methodImage     String?
  methodCta       String?   // CTA link

  // Brand Logos (As Seen On)
  brandLogos      Json?     // [{ name: "Forbes", logo: "..." }]

  // More Articles Section
  moreArticleIds  String[]  @db.ObjectId

  // Explore Categories Section
  exploreCategories Json?   // [{ groupSlug, groupName, icon, links: [{ title, href }] }]

  updatedAt       DateTime  @updatedAt
}

// ============================================
// STATIC PAGE - About Us, Privacy Policy, etc.
// ============================================
model StaticPage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  slug            String   @unique  // "about-us", "privacy-policy", "terms-of-use", "cookie-policy"
  title           String
  description     String?
  content         String   // HTML content
  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}
